# Written automatically by scripts/init-canvas.mjs. Copy to .env.local to set by hand.
# "localnet" (solana-test-validator) or "devnet"
VITE_CLUSTER=localnet
# Program id (defaults to the address in src/idl/place.json)
VITE_PROGRAM_ID=
# optional: custom RPC (defaults to http://127.0.0.1:8899 on localnet, the public devnet RPC on devnet)
VITE_RPC_URL=
