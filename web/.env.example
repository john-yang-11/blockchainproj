# "foundry" for local anvil, "baseSepolia" for testnet
VITE_CHAIN=foundry
VITE_CONTRACT_ADDRESS=0x...
# block the contract was deployed in (history scan starts here)
VITE_DEPLOY_BLOCK=0
# optional: custom RPC (defaults to the chain's public RPC)
VITE_RPC_URL=
# optional: max block range per eth_getLogs request
VITE_LOG_CHUNK=9000
